{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "eyes",
  "version": "1.2.0",
  "identifier": "tools.eyes.desktop",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [],
    "security": {
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp": {
        "default-src": "'none'",
        "base-uri": "'none'",
        "object-src": "'none'",
        "frame-ancestors": "'none'",
        "form-action": "'none'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "img-src": "'self' data: blob:",
        "media-src": "'self' blob: data:",
        "connect-src": "'self' https://drand.cloudflare.com https://eyes.tools ipc: http://ipc.localhost",
        "worker-src": "'self' blob:",
        "script-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Small, local-first tools",
    "longDescription": "Small, local-first tools for text, code, images, and everyday tasks. Open a tool and get a result.",
    "copyright": "Copyright (c) 2026 mzyhot",
    "license": "AGPL-3.0-only",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
