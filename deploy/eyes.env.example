# Keep the origin on loopback and reachable only through your trusted proxies.
PORT=8777
SHARE_TRUST_CLOUDFLARE=1
# Lets the desktop app use share. Unset keeps the service same-origin only.
SHARE_ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost
# Other sites whose pages may call /mcp from a browser. Agents' own servers
# need nothing here; unset keeps browser calls same-origin only.
# MCP_ALLOWED_ORIGINS=https://agent.example
# How many calls to /mcp may run at once, each in a worker thread holding every
# tool: one fewer than the processor's cores, up to four, when left out.
# MCP_WORKERS=1

# Optional TURN relay; use your own credentials. Never commit real secrets.
# SHARE_TURN_URLS=turn:relay.example:3478,turns:relay.example:5349
# SHARE_TURN_SECRET=replace-with-your-relay-shared-secret

# The downloader's server half: the yt-dlp to run (off when unset), where its
# jobs keep files for up to an hour, and, when this service runs as root, the
# user and group to run yt-dlp as. See "Downloader" in deploy/README.md.
# DOWNLOAD_YTDLP=/opt/yt-dlp/bin/yt-dlp
# DOWNLOAD_DIR=/var/lib/eyes-dl
# DOWNLOAD_UID=977
# DOWNLOAD_GID=975
# Lets the desktop app use the downloader, as SHARE_ALLOWED_ORIGINS does share.
# DOWNLOAD_ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost

# HMAC secret for the GitHub deployment webhook; set this locally, never commit it.
# GITHUB_SECRET=replace-with-a-long-random-value
